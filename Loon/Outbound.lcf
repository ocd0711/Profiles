🇺🇸 美国 SS-TLS=shadowsocks,173.242.125.63,8444,chacha20-ietf-poly1305,"dzUjK3l+mXO/OgaqIIat0TiP0VbGUgElA8ZDR2i3dIE=",shadow-tls-password=46f3678c12c8d39c8f2528ac1dc6bd9a2acc2e582e9b5d974d604ce65cdb91db,shadow-tls-sni=p11.douyinpic.com,shadow-tls-version=3,udp=true

[Remote Proxy]
# 订阅节点，格式：别名 = 订阅 URL
守候 = https://sub1.sntp.me/baseStr?token=d4fb0b19c7690ea8bd82ba46f8b141ba&sign=74676a0e9224e884c69c1ae787f965e6&ts=1776778102&nonce=6d78fc56dbf59a3caef10de618708c7d&v=v2&timestamp=151496,udp=default,block-quic=true,fast-open=default,vmess-aead=true,skip-cert-verify=default,enabled=true,flexible-sni=false,img-url=https://raw.githubusercontent.com/black2c7/TheMagic-Icons/main/Icons/Shouhou.png,parser-plugin=5a5d94d84e4a4fe96f49cd3a017121a1

[Remote Filter]
# 筛选订阅节点，筛选后的结果可加入到策略组中，目前支持三种筛选方式
# NodeSelect: 使用在UI上选择的节点。
# NameKeyword: 根据提供的关键词对订阅中所有节点的名称进行筛选，使用筛选后的节点。
# NameRegex: 根据提供的正则表达式对订阅中所有节点的名称进行筛选，使用筛选后的节点。
# 根据自己机场及想用的节点进行删改，如想过滤 “香港 IPLC”，请修改 FilterKey 为 “.*香港 IPLC”
Home_Proxy = NameRegex, FilterKey = "(?=.*Home)^((?!(Gamer|emby)).)*$"
HK_Proxy = NameRegex, FilterKey = "(?=.*(香港|HK|🇭🇰))^((?!(Gamer|emby|Home)).)*$"
TW_Proxy = NameRegex, FilterKey = "(?=.*(台湾|TW|🇹🇼))^((?!(Gamer|emby|Home)).)*$"
JP_Proxy = NameRegex, FilterKey = "(?=.*(日本|JP|🇯🇵))^((?!(Gamer|emby|Home)).)*$"
US_Proxy = NameRegex, FilterKey = "(?=.*(美国|US|🇺🇸))^((?!(Gamer|emby|Home)).)*$"
SG_Proxy = NameRegex, FilterKey = "(?=.*(新加坡|SG|🇸🇬))^((?!(Gamer|emby|Home)).)*$"
EMBY_Proxy = NameRegex, FilterKey = "^(?!.*(Gamer|香港|日本|美国|HK|JP|US|Home)).*$"

[Proxy Group]
Outside = select,Auto,Home,HK,TW,JP,US,SG,DIRECT,守候,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png
Final = select,Outside,DIRECT,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Final.png
Mainland = select,DIRECT,Outside,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Domestic.png
CDN = select,Outside,DIRECT,img-url = https://raw.githubusercontent.com/Orz-3/mini/master/Color/Static.png
# 下载服务
Download = select,Outside,Home,HK,TW,JP,US,SG,DIRECT,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Download.png
# 国际流媒体服务
Global Media = select,Outside,Home,HK,TW,JP,US,SG,DIRECT,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ForeignMedia.png
# Emby 流媒体
EmbyProxy = select,SG,TW,US,EMBY,DIRECT,img-url = https://raw.githubusercontent.com/Orz-3/mini/master/Color/Emby.png
# AI 相关
AI Suite = select,Outside,Home,HK,TW,JP,US,SG,DIRECT,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AI.png
# Telegram 分流
Telegram = select,Outside,Home,HK,TW,JP,US,SG,DIRECT,img-url = https://raw.githubusercontent.com/Orz-3/mini/master/Color/Telegram.png
# Paypal 加速
PayPal = select,Outside,Home,HK,TW,JP,US,SG,DIRECT,img-url = https://raw.githubusercontent.com/Orz-3/mini/master/Color/Paypal.png
# Speedtest 分流
Speedtest = select,Outside,Home,HK,TW,JP,US,SG,DIRECT,img-url = https://raw.githubusercontent.com/Orz-3/mini/master/Color/Speedtest.png
# Duolingo 分流
Duolingo = select,Outside,Home,HK,TW,JP,US,SG,DIRECT,img-url = https://raw.githubusercontent.com/ocd0711/Profiles/master/icon/duolingo_2.png

# 如有不使用的或订阅里没有的国家/地区节点策略组，请在上方规则策略组中一并删除相关节点策略组
Auto = url-test,HK_Proxy,TW_Proxy,JP_Proxy,US_Proxy,SG_Proxy,url = http://www.gstatic.com/generate_204,interval = 300,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Round_Robin.png
Home = url-test,Home_Proxy,url = http://www.gstatic.com/generate_204,interval = 300,img-url = https://raw.githubusercontent.com/ocd0711/Profiles/master/icon/Home.png
HK = url-test,HK_Proxy,url = http://www.gstatic.com/generate_204,interval = 300,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png
TW = url-test,TW_Proxy,url = http://www.gstatic.com/generate_204,interval = 300,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png
JP = url-test,JP_Proxy,url = http://www.gstatic.com/generate_204,interval = 300,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png
US = url-test,US_Proxy,url = http://www.gstatic.com/generate_204,interval = 300,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_States.png
SG = url-test,SG_Proxy,url = http://www.gstatic.com/generate_204,interval = 300,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png
EMBY = url-test,EMBY_Proxy,url = http://www.gstatic.com/generate_204,interval = 300,img-url = https://raw.githubusercontent.com/Orz-3/mini/master/Color/StreamingSE.png

# SSID 策略，格式：别名 = ssid，默认 = 策略， 蜂窝 = 策略，ssid名称 = 策略
